{
"duration": 52.38404166666667,
"lines": [
{
"i": 0,
"id": "hook",
"text": "How do you survive... the Pale Stretcher?",
"start": 0.35,
"end": 2.317
},
{
"i": 1,
"id": "car",
"text": "It's two A.M., and your car dies on an empty forest road.",
"start": 2.667,
"end": 6.107
},
{
"i": 2,
"id": "fog",
"text": "Then, far down the road, in the fog...",
"start": 6.407,
"end": 8.204
},
{
"i": 3,
"id": "stand",
"text": "something is standing.",
"start": 8.454,
"end": 9.642
},
{
"i": 4,
"id": "tall",
"text": "It's nine feet tall, with arms that hang down to its knees.",
"start": 10.192,
"end": 13.391
},
{
"i": 5,
"id": "rule",
"text": "Rule number one: never look at its face.",
"start": 13.741,
"end": 15.776
},
{
"i": 6,
"id": "see",
"text": "If you see it, it screams...",
"start": 16.076,
"end": 17.327
},
{
"i": 7,
"id": "runs",
"text": "and it runs at you. It never stops.",
"start": 17.477,
"end": 19.255
},
{
"i": 8,
"id": "walk",
"text": "Now it's walking toward your car.",
"start": 19.705,
"end": 21.338
},
{
"i": 9,
"id": "woods",
"text": "Run into the woods? No. With those legs, it catches you in seconds.",
"start": 21.688,
"end": 25.105
},
{
"i": 10,
"id": "lock",
"text": "Lock the doors? If it's hunting you, glass won't stop it.",
"start": 25.405,
"end": 28.105
},
{
"i": 11,
"id": "works",
"text": "Here's what works. Lights off, cover your eyes, and slide down into the footwell.",
"start": 28.505,
"end": 32.657
},
{
"i": 12,
"id": "feet",
"text": "Bare feet on the asphalt... right next to your door.",
"start": 33.157,
"end": 35.797
},
{
"i": 13,
"id": "tap",
"text": "Long fingers tap on the window.",
"start": 36.297,
"end": 37.875
},
{
"i": 14,
"id": "still",
"text": "Don't move. Don't breathe. And don't open your eyes.",
"start": 38.775,
"end": 41.369
},
{
"i": 15,
"id": "wait",
"text": "Because it's waiting for you to look.",
"start": 41.669,
"end": 43.415
},
{
"i": 16,
"id": "dawn",
"text": "Keep them shut until sunrise. At dawn, it's gone.",
"start": 44.315,
"end": 47.029
},
{
"i": 17,
"id": "cta",
"text": "Would you have survived? Follow, because part four is coming for you.",
"start": 47.479,
"end": 50.784
}
],
