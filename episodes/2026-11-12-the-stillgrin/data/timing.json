{
"duration": 43.39675,
"lines": [
{
"i": 0,
"id": "hook",
"text": "It's almost midnight. You take the trash out.",
"start": 2.6,
"end": 4.87
},
{
"i": 1,
"id": "on",
"text": "The motion light on the shed clicks on.",
"start": 5.17,
"end": 6.96
},
{
"i": 2,
"id": "still",
"text": "You stand still... and it clicks off.",
"start": 7.21,
"end": 8.992
},
{
"i": 3,
"id": "again",
"text": "Then it clicks on again.",
"start": 9.442,
"end": 10.581
},
{
"i": 4,
"id": "move",
"text": "But you didn't move.",
"start": 10.781,
"end": 11.76
},
{
"i": 5,
"id": "taps",
"text": "Behind the fence... something taps.",
"start": 12.31,
"end": 14.118
},
{
"i": 6,
"id": "curl",
"text": "Long grey fingers curl over the top.",
"start": 15.118,
"end": 17.018
},
{
"i": 7,
"id": "rise",
"text": "Then a face rises above it. Much too high.",
"start": 17.318,
"end": 19.695
},
{
"i": 8,
"id": "out",
"text": "The light goes out.",
"start": 20.195,
"end": 21.199
},
{
"i": 9,
"id": "back",
"text": "When it clicks back on... it's in your garden.",
"start": 22.199,
"end": 24.281
},
{
"i": 10,
"id": "frozen",
"text": "Frozen. Halfway to you.",
"start": 24.481,
"end": 25.863
},
{
"i": 11,
"id": "dark",
"text": "It only moves in the dark.",
"start": 26.163,
"end": 27.543
},
{
"i": 12,
"id": "stays",
"text": "And the light only stays on while something moves.",
"start": 27.743,
"end": 30.217
},
{
"i": 13,
"id": "two",
"text": "You have two options.",
"start": 30.517,
"end": 31.586
},
{
"i": 14,
"id": "optA",
"text": "Keep waving your arms, and back away to the house...",
"start": 31.736,
"end": 34.234
},
{
"i": 15,
"id": "optB",
"text": "or drop the bag and sprint for the door, in the dark.",
"start": 34.384,
"end": 36.769
},
{
"i": 16,
"id": "q",
"text": "What do you do?",
"start": 37.069,
"end": 37.862
},
{
"i": 17,
"id": "cta",
"text": "Wave or sprint? Tell me in the comments, and follow for more.",
"start": 38.212,
"end": 41.397
}
],
