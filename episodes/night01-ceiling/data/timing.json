{
"duration": 42.65229166666666,
"lines": [
{
"i": 0,
"id": "intro",
"text": "You're home alone... when something falls over downstairs.",
"start": 4.7,
"end": 7.64
},
{
"i": 1,
"id": "cough",
"text": "Then... someone coughs.",
"start": 8.14,
"end": 9.38
},
{
"i": 2,
"id": "check",
"text": "You grab your phone, and go down to check.",
"start": 10.18,
"end": 12.067
},
{
"i": 3,
"id": "normal",
"text": "The living room looks... normal.",
"start": 12.467,
"end": 14.062
},
{
"i": 4,
"id": "peek",
"text": "But something is peeking around the door frame... from the ceiling.",
"start": 15.762,
"end": 19.039
},
{
"i": 5,
"id": "crawl",
"text": "It crawls toward you, upside down.",
"start": 19.439,
"end": 21.331
},
{
"i": 6,
"id": "run",
"text": "You run upstairs, and lock your door.",
"start": 21.631,
"end": 23.343
},
{
"i": 7,
"id": "tap",
"text": "Then it taps on your door. Softly.",
"start": 23.843,
"end": 25.703
},
{
"i": 8,
"id": "fingers",
"text": "Its long fingers slide under the gap.",
"start": 26.303,
"end": 28.125
},
{
"i": 9,
"id": "clue",
"text": "It only crawls on the ceiling, and it never looks down.",
"start": 28.525,
"end": 31.305
},
{
"i": 10,
"id": "opts",
"text": "You have two options. Hide under your bed... or climb out the window, onto the roof.",
"start": 31.655,
"end": 36.375
},
{
"i": 11,
"id": "what",
"text": "What do you do?",
"start": 36.675,
"end": 37.505
},
{
"i": 12,
"id": "cta",
"text": "Comment A or B, and follow, so you don't miss the next night.",
"start": 38.005,
"end": 41.152
}
],
