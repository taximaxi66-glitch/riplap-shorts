{
"duration": 46.498041666666666,
"lines": [
{
"i": 0,
"id": "hook",
"text": "It's three a.m. Everyone's asleep. And someone rings your doorbell.",
"start": 1.5,
"end": 5.295
},
{
"i": 1,
"id": "down",
"text": "You creep downstairs.",
"start": 5.645,
"end": 6.747
},
{
"i": 2,
"id": "glass",
"text": "Through the glass... nobody's there.",
"start": 6.997,
"end": 8.672
},
{
"i": 3,
"id": "again",
"text": "Then it rings again.",
"start": 9.022,
"end": 10.011
},
{
"i": 4,
"id": "peep",
"text": "You look through the peephole. An empty porch.",
"start": 10.311,
"end": 12.43
},
{
"i": 5,
"id": "button",
"text": "But the doorbell button is still pressed down...",
"start": 12.73,
"end": 14.855
},
{
"i": 6,
"id": "finger",
"text": "by a long grey finger, reaching down from above.",
"start": 15.105,
"end": 17.829
},
{
"i": 7,
"id": "bends",
"text": "Then something bends down... and looks right back at you.",
"start": 18.429,
"end": 21.423
},
{
"i": 8,
"id": "tall",
"text": "It's twice as tall as your door. Its neck folds like an old ladder.",
"start": 21.923,
"end": 25.863
},
{
"i": 9,
"id": "slot",
"text": "The letterbox flips open.",
"start": 26.213,
"end": 27.625
},
{
"i": 10,
"id": "feel",
"text": "Long fingers slide in, feeling for you.",
"start": 27.925,
"end": 29.882
},
{
"i": 11,
"id": "hears",
"text": "It can't fit through the door. But it hears every creak.",
"start": 30.182,
"end": 32.841
},
{
"i": 12,
"id": "two",
"text": "You have two options.",
"start": 33.191,
"end": 34.26
},
{
"i": 13,
"id": "optA",
"text": "Sneak up the creaky stairs to your room...",
"start": 34.46,
"end": 36.371
},
{
"i": 14,
"id": "optB",
"text": "or stay perfectly still, right next to the door, until it leaves.",
"start": 36.571,
"end": 40.002
},
{
"i": 15,
"id": "q",
"text": "What do you do?",
"start": 40.302,
"end": 41.095
},
{
"i": 16,
"id": "cta",
"text": "Stairs or stay? Tell me in the comments, and follow for more.",
"start": 41.495,
"end": 44.498
}
],
