{
"duration": 53.913,
"lines": [
{
"i": 0,
"id": "hook",
"text": "How do you survive... the Mimicker?",
"start": 0.35,
"end": 1.939
},
{
"i": 1,
"id": "gas",
"text": "It's three A.M., and you stop for gas at an empty desert station.",
"start": 2.289,
"end": 6.1
},
{
"i": 2,
"id": "voice",
"text": "Then, from the dark, you hear your mom calling your name.",
"start": 6.4,
"end": 8.999
},
{
"i": 3,
"id": "but",
"text": "But your mom died last year.",
"start": 10.849,
"end": 12.406
},
{
"i": 4,
"id": "light",
"text": "Something steps into the light.",
"start": 12.906,
"end": 14.361
},
{
"i": 5,
"id": "tall",
"text": "It's nine feet tall, and its jaw hangs down to its chest.",
"start": 14.761,
"end": 17.904
},
{
"i": 6,
"id": "rule",
"text": "Rule number one: it copies voices, and it can't come inside... unless you answer.",
"start": 18.204,
"end": 22.992
},
{
"i": 7,
"id": "calls",
"text": "Now it's calling you, in your mother's voice.",
"start": 23.292,
"end": 25.199
},
{
"i": 8,
"id": "run",
"text": "Run for your car? No. It rips the door right off.",
"start": 27.399,
"end": 29.715
},
{
"i": 9,
"id": "shout",
"text": "Yell at it to go away? That's an answer, and now it's inside.",
"start": 30.015,
"end": 33.093
},
{
"i": 10,
"id": "works",
"text": "Here's what works. Get inside, lock the door, and cover your ears.",
"start": 33.493,
"end": 36.823
},
{
"i": 11,
"id": "glass",
"text": "Its face presses against the glass... right next to you.",
"start": 37.273,
"end": 40.266
},
{
"i": 12,
"id": "begs",
"text": "It begs you to answer.",
"start": 40.566,
"end": 41.724
},
{
"i": 13,
"id": "dont",
"text": "Don't. Say. A word.",
"start": 43.574,
"end": 44.785
},
{
"i": 14,
"id": "dawn",
"text": "At dawn, the voice goes quiet, and it walks back into the desert.",
"start": 45.285,
"end": 48.597
},
{
"i": 15,
"id": "cta",
"text": "Would you have survived? Follow, because part six is coming for you.",
"start": 48.997,
"end": 52.313
}
],
