{
"duration": 53.378083333333336,
"lines": [
{
"i": 0,
"id": "hook",
"text": "How do you survive... the Frostjaw?",
"start": 0.35,
"end": 2.116
},
{
"i": 1,
"id": "lake",
"text": "It's midnight, and you're ice fishing alone on a frozen lake.",
"start": 2.466,
"end": 5.511
},
{
"i": 2,
"id": "snap",
"text": "Then your line snaps...",
"start": 5.811,
"end": 6.943
},
{
"i": 3,
"id": "climb",
"text": "and far out on the ice, something crawls out of the water.",
"start": 7.243,
"end": 10.322
},
{
"i": 4,
"id": "tall",
"text": "It's eight feet tall, and its face is split open from chin to forehead.",
"start": 10.822,
"end": 14.673
},
{
"i": 5,
"id": "rule",
"text": "Rule number one: it's blind. It hunts by sound.",
"start": 15.023,
"end": 17.731
},
{
"i": 6,
"id": "noise",
"text": "Make one noise...",
"start": 18.031,
"end": 19.058
},
{
"i": 7,
"id": "finds",
"text": "and it finds you.",
"start": 19.208,
"end": 20.166
},
{
"i": 8,
"id": "turn",
"text": "Now its head is turning toward you.",
"start": 20.616,
"end": 22.272
},
{
"i": 9,
"id": "run",
"text": "Run for the cabin? No. The ice cracks under every step.",
"start": 22.622,
"end": 25.461
},
{
"i": 10,
"id": "call",
"text": "Call for help? Your phone buzzes, and it hears that too.",
"start": 25.761,
"end": 28.472
},
{
"i": 11,
"id": "works",
"text": "Here's what works. Phone off, lie flat, and breathe into your sleeve.",
"start": 28.872,
"end": 32.21
},
{
"i": 12,
"id": "feet",
"text": "Its feet crunch across the ice... right next to your head.",
"start": 32.71,
"end": 35.843
},
{
"i": 13,
"id": "jaw",
"text": "Its jaw opens, inches above your face.",
"start": 36.343,
"end": 38.699
},
{
"i": 14,
"id": "still",
"text": "Don't move. Don't breathe.",
"start": 39.399,
"end": 40.683
},
{
"i": 15,
"id": "throw",
"text": "Now throw your ice pick far across the lake.",
"start": 41.283,
"end": 43.415
},
{
"i": 16,
"id": "chase",
"text": "It chases the sound, and you crawl to shore.",
"start": 43.615,
"end": 45.76
},
{
"i": 17,
"id": "dawn",
"text": "At dawn, it slides back under the ice.",
"start": 46.21,
"end": 48.052
},
{
"i": 18,
"id": "cta",
"text": "Would you have survived? Follow, because part five is coming for you.",
"start": 48.502,
"end": 51.778
}
],
