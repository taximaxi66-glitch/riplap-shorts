{
"duration": 44.57095833333333,
"lines": [
{
"i": 0,
"id": "hook",
"text": "It's two a.m. You sneak downstairs for a midnight snack.",
"start": 1.7,
"end": 4.739
},
{
"i": 1,
"id": "quiet",
"text": "Everyone's asleep. The fridge is the only light.",
"start": 4.989,
"end": 7.556
},
{
"i": 2,
"id": "tap",
"text": "Then... tap. Tap. Tap.",
"start": 8.006,
"end": 9.463
},
{
"i": 3,
"id": "win",
"text": "Something is tapping on the kitchen window.",
"start": 9.763,
"end": 11.738
},
{
"i": 4,
"id": "branch",
"text": "Just a branch? No. Those are fingers.",
"start": 12.038,
"end": 14.014
},
{
"i": 5,
"id": "gone",
"text": "Then they're gone.",
"start": 14.464,
"end": 15.31
},
{
"i": 6,
"id": "door",
"text": "Something creaks at the back door.",
"start": 15.91,
"end": 17.435
},
{
"i": 7,
"id": "gap",
"text": "And a hand slides through the gap underneath. Flat. Like paper.",
"start": 17.735,
"end": 21.239
},
{
"i": 8,
"id": "unfold",
"text": "It peels itself off the floor, and unfolds.",
"start": 21.639,
"end": 23.989
},
{
"i": 9,
"id": "eyes",
"text": "Its eyes shine in the fridge light. It only sees what's lit.",
"start": 24.489,
"end": 27.787
},
{
"i": 10,
"id": "you",
"text": "And the only light in the house is on you.",
"start": 28.137,
"end": 30.045
},
{
"i": 11,
"id": "closer",
"text": "It twitches closer.",
"start": 30.495,
"end": 31.627
},
{
"i": 12,
"id": "two",
"text": "You have two options.",
"start": 31.927,
"end": 32.996
},
{
"i": 13,
"id": "optA",
"text": "Slam the fridge shut, and freeze in total darkness.",
"start": 33.196,
"end": 35.797
},
{
"i": 14,
"id": "optB",
"text": "Or leave it open, and run for the stairs.",
"start": 36.047,
"end": 37.982
},
{
"i": 15,
"id": "q",
"text": "What do you do?",
"start": 38.282,
"end": 39.075
},
{
"i": 16,
"id": "cta",
"text": "Fridge or stairs? Tell me in the comments, and follow for more.",
"start": 39.475,
"end": 42.571
}
],
